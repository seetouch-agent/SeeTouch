# Copy to .env.e2e (ignored by git) and fill in a vision-capable model.
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://your-gateway.example/v1
OPENAI_MODEL_ID=deepseek-flash
OPENAI_API_MODE=chat_completions
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT=90
OPENAI_MAX_RETRIES=0
SEETOUCH_TASK_TIMEOUT=900
SEETOUCH_MAX_MODEL_RETRIES=1
SEETOUCH_APPLIST_PATH=/home/your-user/.seetouch/applist.json
# httpx does not bundle SOCKS support; leave these empty unless socksio is installed.
ALL_PROXY=
all_proxy=
