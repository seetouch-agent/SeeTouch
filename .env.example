# CLI run 默认使用 Gemini；debug 和 Android App 当前仍使用 Doubao。
# 模型是否可用、价格和配额以服务商和实际项目为准。
# 复制为本地 .env 后填入 key；不要提交真实凭据。

# Gemini（CLI）
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.1-flash-lite

# Doubao（CLI --reasoner doubao / Web debug）
VLM_API_KEY=
DOUBAO_MODEL_ID=doubao-seed-1-6-vision-250815
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3
# enabled / disabled；auto 取决于模型，默认 Vision 模型历史测试不支持。
SEETOUCH_THINKING_MODE=enabled

# OpenAI / OpenAI 兼容中转站（CLI --reasoner openai）
OPENAI_API_KEY=
OPENAI_MODEL_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODE=chat_completions
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=1
# 留空保持模型默认；仅填写模型支持的 none/minimal/low/medium/high/xhigh。
OPENAI_REASONING_EFFORT=

# CLI 运行配置
SEETOUCH_DEVICE_SERIAL=
SEETOUCH_RUNS_DIR=./runs
SEETOUCH_MAX_STEPS=45
SEETOUCH_LOG_LEVEL=INFO
SEETOUCH_TASK_TIMEOUT=0
SEETOUCH_MAX_MODEL_RETRIES=1
SEETOUCH_MAX_CONSECUTIVE_FAILURES=2
SEETOUCH_MAX_CONSECUTIVE_IDENTICAL_ACTIONS=5
SEETOUCH_MAX_OPEN_MISSES=3
SEETOUCH_ACTION_SETTLE_SECONDS=1.0
# SEETOUCH_APPLIST_PATH=/path/to/applist.json
